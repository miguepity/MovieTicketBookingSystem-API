// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Cines {
  id                   BigInt                @id @default(autoincrement())
  nombre               String                @db.VarChar(150)
  direccion            String?               @db.VarChar(255)
  id_ciudad            BigInt
  ciudades             Ciudades              @relation(fields: [id_ciudad], references: [id])
  activo               Boolean               @default(true)
  created_at           DateTime              @default(now()) @db.Timestamptz
  salas                Salas[]
  precios_cine         PreciosCine[]
  politicasCancelacion PoliticaCancelacion[]

  @@map("cines")
}

model Ciudades {
  id         BigInt   @id @default(autoincrement())
  nombre     String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz
  cines      Cines[]

  @@map("ciudades")
}

model Salas {
  id         BigInt      @id @default(autoincrement())
  nombre     String      @db.VarChar(50)
  id_cine    BigInt
  cines      Cines       @relation(fields: [id_cine], references: [id])
  filas      Int
  columnas   Int
  created_at DateTime    @default(now()) @db.Timestamptz
  asientos   Asientos[]
  funciones  Funciones[]

  @@map("salas")
}

model Asientos {
  id               BigInt            @id @default(autoincrement())
  id_sala          BigInt
  salas            Salas             @relation(fields: [id_sala], references: [id])
  fila             String            @db.Char(2)
  columna          Int
  codigo           String            @db.VarChar(10)
  id_tipo_asiento  BigInt
  tipoAsiento      TiposAsiento      @relation(fields: [id_tipo_asiento], references: [id])
  asientosFuncions AsientosFuncion[]

  @@unique([id_sala, fila, columna])
  @@map("asientos")
}

model TiposAsiento {
  id           BigInt        @id @default(autoincrement())
  nombre       String        @unique @db.VarChar(30)
  color        String?       @db.Char(7)
  asientos     Asientos[]
  precios_cine PreciosCine[]

  @@map("tipos_asiento")
}

model PreciosCine {
  id              BigInt       @id @default(autoincrement())
  id_cine         BigInt?
  id_tipo_asiento BigInt
  precio          Decimal      @db.Decimal(10, 2)
  cine            Cines?       @relation(fields: [id_cine], references: [id])
  tipo_asiento    TiposAsiento @relation(fields: [id_tipo_asiento], references: [id])
  created_at      DateTime     @default(now()) @db.Timestamptz
  updated_at      DateTime     @updatedAt @db.Timestamptz

  @@unique([id_cine, id_tipo_asiento])
  @@map("precios_cine")
}

model AsientosFuncion {
  id              BigInt                @id @default(autoincrement())
  id_asiento      BigInt
  asientos        Asientos              @relation(fields: [id_asiento], references: [id])
  id_funcion      BigInt
  funciones       Funciones             @relation(fields: [id_funcion], references: [id])
  estado          AsientoFuncionEstado
  id_usuario      BigInt?
  usuarios        Usuarios?         @relation(fields: [id_usuario], references: [id])
  bloqueado_hasta DateTime          @default(now()) @db.Timestamptz
  version         Int
  reservaAsientos ReservaAsientos[]

  @@map("asientos_funcion")
}

model Reservas {
  id              BigInt            @id @default(autoincrement())
  numero_reserva  String            @unique @db.VarChar(20)
  id_usuario      BigInt
  usuarios        Usuarios          @relation(fields: [id_usuario], references: [id])
  id_funcion      BigInt
  funciones       Funciones         @relation(fields: [id_funcion], references: [id])
  estado          ReservaEstado
  notas_internas  String?           @db.Text
  expira_en       DateTime?         @db.Timestamptz
  created_at      DateTime          @default(now()) @db.Timestamptz
  updated_at      DateTime          @updatedAt @db.Timestamptz
  reservaAsientos ReservaAsientos[]
  pagos           Pagos[]

  @@map("reservas")
}

model ReservaAsientos {
  id                 BigInt          @id @default(autoincrement())
  id_reserva         BigInt
  reservas           Reservas        @relation(fields: [id_reserva], references: [id])
  id_asiento_funcion BigInt
  asientosfuncion    AsientosFuncion @relation(fields: [id_asiento_funcion], references: [id])

  @@map("reserva_asientos")
}

model Pagos {
  id                 BigInt       @id @default(autoincrement())
  id_reserva         BigInt
  reservas           Reservas     @relation(fields: [id_reserva], references: [id])
  id_cupon           BigInt?
  cupones            Cupones?     @relation(fields: [id_cupon], references: [id])
  monto_original     Decimal      @db.Decimal(10, 2)
  monto_descuento    Decimal      @db.Decimal(10, 2)
  monto_final        Decimal      @db.Decimal(10, 2)
  metodo             String       @db.VarChar(20)
  estado             PagoEstado
  referencia_externa String?      @db.VarChar(255)
  created_at         DateTime     @default(now()) @db.Timestamptz
  reembolsos         Reembolsos[]
  id_metodo_pago     BigInt?
  metodo_pago        MetodosPago? @relation(fields: [id_metodo_pago], references: [id], onDelete: SetNull)
  marca_snapshot     String?      @db.VarChar(20)
  ultimos4_snapshot  String?      @db.Char(4)

  @@map("pagos")
}

model MetodosPago {
  id             BigInt   @id @default(autoincrement())
  id_usuario     BigInt
  usuarios       Usuarios @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  tipo           String   @db.VarChar(20)

  marca          String?  @db.VarChar(20)
  ultimos4       String?  @db.Char(4)
  expiracion     String?  @db.Char(5)
  titular        String?  @db.VarChar(120)
  pan_cifrado    String?  @db.Text

  predeterminado Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz

  pagos          Pagos[]

  @@index([id_usuario])
  @@map("metodos_pago")
}

model Cupones {
  id               BigInt   @id @default(autoincrement())
  codigo           String   @unique @db.VarChar(50)
  tipo             String   @db.VarChar(20)
  valor            Decimal  @db.Decimal(10, 2)
  fecha_expiracion DateTime @db.Date
  usos_maximos     Int?
  usos_actuales    Int      @default(0)
  titulo           String?  @db.VarChar(100)
  descripcion      String?  @db.Text
  activo           Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz
  pagos            Pagos[]

  @@map("cupones")
}

model PoliticaCancelacion {
  id         BigInt                     @id @default(autoincrement())
  id_cine    BigInt
  cines      Cines                      @relation(fields: [id_cine], references: [id])
  nombre     String                     @db.VarChar(100)
  activa     Boolean                    @default(true)
  created_at DateTime                   @default(now()) @db.Timestamptz
  reglas     ReglaPoliticaCancelacion[]
  reembolsos Reembolsos[]

  @@index([id_cine])
  @@map("politica_cancelacion")
}

model ReglaPoliticaCancelacion {
  id                   BigInt              @id @default(autoincrement())
  id_politica          BigInt
  politica             PoliticaCancelacion @relation(fields: [id_politica], references: [id], onDelete: Cascade)
  horas_antes_minimo   Int
  horas_antes_maximo   Int?
  porcentaje_reembolso Decimal             @db.Decimal(5, 2)

  @@index([id_politica])
  @@map("regla_politica_cancelacion")
}

model Reembolsos {
  id                  BigInt               @id @default(autoincrement())
  id_pago             BigInt
  pagos               Pagos                @relation(fields: [id_pago], references: [id])
  id_politica         BigInt?
  politica            PoliticaCancelacion? @relation(fields: [id_politica], references: [id])
  porcentaje_aplicado Decimal              @default(0) @db.Decimal(5, 2)
  monto               Decimal              @db.Decimal(10, 2)
  estado              ReembolsoEstado
  fecha_procesado     DateTime?            @db.Timestamptz
  motivo_rechazo      String?
  nota                String?
  created_at          DateTime             @default(now()) @db.Timestamptz

  @@index([id_politica])
  @@map("reembolsos")
}

model Funciones {
  id               BigInt            @id @default(autoincrement())
  id_pelicula      BigInt
  peliculas        Peliculas         @relation(fields: [id_pelicula], references: [id])
  id_sala          BigInt
  salas            Salas             @relation(fields: [id_sala], references: [id])
  fecha_hora       DateTime          @db.Timestamptz
  estado           FuncionEstado
  created_at       DateTime          @default(now()) @db.Timestamptz
  asientosFuncions AsientosFuncion[]
  reservas         Reservas[]

  @@map("funciones")
}

model Peliculas {
  id            BigInt      @id @default(autoincrement())
  titulo        String      @db.VarChar(200)
  sinopsis      String?     @db.Text
  poster_url    String?     @db.VarChar(500)
  id_idioma     BigInt?
  idiomas       Idiomas?    @relation(fields: [id_idioma], references: [id])
  id_genero     BigInt?
  generos       Generos?    @relation(fields: [id_genero], references: [id])
  fecha_estreno DateTime?   @db.Date
  duracion_min  Int?
  ficha_tecnica Json?
  tagline       String?     @db.VarChar(200)
  rating_promedio Decimal?  @db.Decimal(3, 2)
  rating_count  Int         @default(0)
  activo        Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamptz
  updated_at    DateTime    @updatedAt @db.Timestamptz
  deleted_at    DateTime?   @db.Timestamptz
  id_usuario    BigInt
  usuarios      Usuarios    @relation(fields: [id_usuario], references: [id])
  funciones     Funciones[]
  calificaciones CalificacionPelicula[]

  @@map("peliculas")
}

model Roles {
  id       BigInt     @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(30)
  usuarios Usuarios[]

  @@map("roles")
}

model Usuarios {
  id                     BigInt               @id @default(autoincrement())
  nombre                 String               @db.VarChar(150)
  email                  String               @unique @db.VarChar(200)
  password_hash          String               @db.VarChar(255)
  telefono               String?              @db.VarChar(20)
  id_rol                 BigInt
  roles                  Roles                @relation(fields: [id_rol], references: [id])
  estado                 String               @db.VarChar(20)
  notificaciones_activas Boolean              @default(false)
  ultimo_acceso          DateTime?            @db.Timestamptz
  password_temporal      Boolean              @default(false)
  created_at             DateTime             @default(now()) @db.Timestamptz
  updated_at             DateTime             @updatedAt @db.Timestamptz
  audit_logs_usuario     AuditLog[]           @relation("AuditLogUsuario")
  audit_logs_auditor     AuditLog[]           @relation("AuditLogAuditor")
  asientosFuncions       AsientosFuncion[]
  reservas               Reservas[]
  peliculas              Peliculas[]
  passwordResetTokens    PasswordResetToken[]
  metodos_pago           MetodosPago[]
  calificaciones         CalificacionPelicula[]

  @@map("usuarios")
}

model Idiomas {
  id        BigInt      @id @default(autoincrement())
  nombre    String      @unique @db.VarChar(60)
  peliculas Peliculas[]

  @@map("idiomas")
}

model Generos {
  id        BigInt      @id @default(autoincrement())
  nombre    String      @unique @db.VarChar(60)
  peliculas Peliculas[]

  @@map("generos")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  id_usuario    BigInt
  usuarios      Usuarios @relation("AuditLogUsuario", fields: [id_usuario], references: [id])
  id_auditor    BigInt
  realizado_por Usuarios @relation("AuditLogAuditor", fields: [id_auditor], references: [id])
  accion        String   @db.VarChar(100)
  detalle       String?  @db.Text

  entidad        String?  @db.VarChar(40)
  entidad_id     BigInt?
  valor_anterior Json?
  valor_nuevo    Json?

  created_at    DateTime @default(now()) @db.Timestamptz

  @@index([entidad, entidad_id])
  @@index([created_at])
  @@index([accion])
  @@map("audit_log")
}

model PasswordResetToken {
  id         BigInt   @id @default(autoincrement())
  id_usuario BigInt
  usuarios   Usuarios @relation(fields: [id_usuario], references: [id])
  token      String   @unique @db.VarChar(255)
  expires_at DateTime @db.Timestamptz
  usado      Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("password_reset_token")
}

model JwtBlacklist {
  jti        String   @id @db.VarChar(64)
  id_usuario BigInt
  expires_at DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([expires_at])
  @@map("jwt_blacklist")
}

model CalificacionPelicula {
  id          BigInt    @id @default(autoincrement())
  id_pelicula BigInt
  pelicula    Peliculas @relation(fields: [id_pelicula], references: [id], onDelete: Cascade)
  id_usuario  BigInt
  usuario     Usuarios  @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  puntuacion  Int
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz

  @@unique([id_pelicula, id_usuario])
  @@index([id_pelicula])
  @@map("calificacion_pelicula")
}

enum ReservaEstado {
  pendiente_pago
  pagada
  cancelada
  reembolsada
  expirada
}

enum PagoEstado {
  procesando
  exitoso
  rechazado
  reembolsado
}

enum FuncionEstado {
  programada
  en_curso
  finalizada
  cancelada
}

enum AsientoFuncionEstado {
  disponible
  bloqueado
  reservado
  ocupado
}

enum ReembolsoEstado {
  pendiente
  procesado
  rechazado
}
